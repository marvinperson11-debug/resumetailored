# Supabase (browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_live_xxx
CLERK_SECRET_KEY=sk_test_or_live_xxx

# Anthropic (server-side) — powers the Resume Tailor, ATS Scanner, Cover Letter
# tools. Without it those API routes return `not_configured` (ATS falls back to
# a deterministic keyword-overlap result).
ANTHROPIC_API_KEY=sk-ant-xxx

# Shared-secret bridge to the legacy site (Stripe checkout + entitlement sync).
# Already used by /api/create-checkout-session and lib/plan.ts.
ENTITLEMENT_SYNC_SECRET=
LEGACY_SITE_URL=https://resumetailored.com
