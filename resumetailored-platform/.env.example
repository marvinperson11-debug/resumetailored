# Supabase (browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_live_xxx
CLERK_SECRET_KEY=sk_test_or_live_xxx

# Anthropic (server-side) — powers the Resume Tailor, ATS Scanner, Cover Letter
# tools. Without it those API routes return `not_configured` (ATS falls back to
# a deterministic keyword-overlap result).
ANTHROPIC_API_KEY=sk-ant-xxx

# Shared-secret bridge to the legacy site (Stripe checkout + entitlement sync).
# Already used by /api/create-checkout-session and lib/plan.ts.
ENTITLEMENT_SYNC_SECRET=
LEGACY_SITE_URL=https://resumetailored.com

# Supabase service-role key (server-only) — used to persist generated resumes /
# cover letters / ATS scans to the `generations` table and to drive the
# dashboard stats. Never expose to the browser. Without it, persistence is
# skipped (best-effort) and the dashboard shows zeros.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional) — transactional email. Powers employer→candidate message
# notifications, interview confirmations, public-application alerts, and team
# invites. Without RESEND_API_KEY every email is skipped silently (best-effort).
# RESEND_FROM is the verified sender on the resumetailored.com domain (DKIM via
# resend._domainkey on the apex). Defaults to noreply@resumetailored.com.
RESEND_API_KEY=
RESEND_FROM=ResumeTailored <noreply@resumetailored.com>

# DocuSign eSignature (Employer Portal — offer letters, feature #10). Uses the
# Authorization Code Grant against the DocuSign REST API v2.1 (no SDK). Without
# DOCUSIGN_INTEGRATION_KEY + DOCUSIGN_SECRET_KEY the Offer Letters page shows a
# "not configured" state and the Send-offer action is disabled. The Redirect URI
# below must be added to the app's "Redirect URIs" list in the DocuSign portal
# EXACTLY as: https://app.resumetailored.com/api/employer/docusign/callback
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_AUTH_SERVER=https://account-d.docusign.com
# Optional — override the OAuth redirect URI (defaults to
# <NEXT_PUBLIC_APP_URL or https://app.resumetailored.com>/api/employer/docusign/callback).
DOCUSIGN_REDIRECT_URI=
# Shared secret for the DocuSign Connect webhook HMAC (X-DocuSign-Signature-1).
# Unset ⇒ the webhook rejects all posts; envelope statuses still sync via the
# fallback poll on the Offer Letters page.
DOCUSIGN_WEBHOOK_SECRET=
# Optional — dedicated key for encrypting refresh tokens at rest (AES-256-GCM).
# Falls back to DOCUSIGN_SECRET_KEY so encryption works with the creds above.
DOCUSIGN_TOKEN_ENC_KEY=

# Daily.co video interviews (Employer Portal — Scheduler). Without DAILY_API_KEY
# the scheduler falls back to manual meeting links with a warning banner. Get a
# free key at daily.co. Register the webhook URL below in the Daily dashboard:
# https://app.resumetailored.com/api/daily/webhook
DAILY_API_KEY=
# Optional — HMAC secret for the Daily Connect webhook (X-Webhook-Signature).
# Unset ⇒ the webhook accepts unsigned posts (still validates payload shape).
DAILY_WEBHOOK_SECRET=
