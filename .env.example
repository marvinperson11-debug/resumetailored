ANTHROPIC_API_KEY=your_anthropic_api_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID=your_stripe_price_id_here
# Optional — Employer Portal Pro plan ($29/mo). Create this Price in the Stripe
# dashboard (subscription mode) and set it here. When unset, /api/employer/subscribe
# returns a friendly "not yet available" message; free Employer accounts (3 active
# job posts) still work.
STRIPE_EMPLOYER_PRICE_ID=
PORT=3000
RESEND_API_KEY=your_resend_api_key_here
OWNER_EMAIL=your@email.com
# Owner activity alerts (signup, tailoring, new/cancelled subscription, login, download)
# email OWNER_EMAIL by default. Set to "off" to silence them all.
OWNER_ALERTS=on
ADMIN_SECRET=choose_a_long_random_secret_here
# Optional — comma-separated emails treated as subscribers (comped/unlimited).
COMP_EMAILS=
# ─── Job Finder providers (multi-source; see job-providers.js) ───────────────
# The Job Finder fans out across every CONFIGURED provider and merges results,
# so one provider failing never empties the page. Even with NO keys set, the
# zero-key remote fallbacks (Remotive/Jobicy/Arbeitnow/The Muse) return live
# jobs. Add a keyed provider below for full nationwide + on-site US coverage.
#
# RECOMMENDED: Adzuna — free signup at https://developer.adzuna.com, full US
# coverage across ALL sectors including skilled trades (HVAC, electricians…).
# This is the best source for nationwide, non-remote US search.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=us            # 2-letter country code (us, gb, ca, au…)
# Optional — JSearch via RapidAPI (jsearch.p.rapidapi.com). NOTE: requires an
# ACTIVE subscription to the JSearch API on RapidAPI (even the free tier) or it
# returns HTTP 403 and is skipped. Kept for continuity; Adzuna is preferred.
RAPIDAPI_KEY=your_rapidapi_key_here
# Optional — USAJOBS (US federal jobs). Free key at https://developer.usajobs.gov
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Set to 1 to disable the zero-key remote fallback providers.
JOB_FALLBACKS_OFF=
# Career Hub scheduled jobs (in-process; see career-cron.js + docs/RAILWAY_CRON.md).
# Off by default so nothing auto-spends credits / sends email. Set to "on" (in the
# WEB service's env, since the jobs need its SQLite volume) to run them daily.
CAREER_CRON=off
CAREER_WARM_HOUR_UTC=7       # nightly `npm run career:warm` (needs ANTHROPIC_API_KEY)
CAREER_DIGEST_HOUR_UTC=13    # daily AM `npm run career:job-digest` (needs RAPIDAPI_KEY + RESEND_API_KEY)
JOB_FEED_REFRESH_HOURS=6     # `npm run career:job-feed` cadence (1-24h) — populates job_feed for the "Jobs for You" feed
# Optional — Job Feed Aggregator: company career-page RSS feeds, the one
# source with no partner-approval gate (Indeed/ZipRecruiter both require
# business approval, not a signup key — see EMPLOYER_PORTAL_PLAN.md).
# Comma-separated "profession_id|label|https://feed-url" triples, e.g.:
# JOB_FEED_RSS_URLS=registered-nurse|Acme Health|https://acme.health/careers.rss
JOB_FEED_RSS_URLS=
# Optional — only meaningful once you have real partner credentials; the
# adapters in scripts/refresh-job-feed.js are stubbed until then.
INDEED_PUBLISHER_ID=
ZIPRECRUITER_API_KEY=
# Optional — LinkedIn OAuth import (free onboarding feature). When CLIENT_ID and
# CLIENT_SECRET are set, the "Import from LinkedIn" button appears and the
# /api/auth/linkedin flow prefills the builder with the user's name/email/photo
# (via "Sign In with LinkedIn using OpenID Connect", scope: openid profile
# email). Leave unset to hide the feature entirely. REDIRECT_URI defaults to
# <origin>/api/auth/linkedin/callback — register that exact URL in the LinkedIn
# app and here if your public origin differs.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Optional — explicit path to a Chrome/Chromium binary for Remotion rendering.
# Leave unset on servers: Remotion uses its own chrome-headless-shell. Only set
# this to a binary that still supports old headless mode (most recent Chromium
# builds do NOT), otherwise rendering fails to launch the browser.
REMOTION_BROWSER_EXECUTABLE=
# Optional — resume-video voiceover (free). Piper (natural) is used when
# available, else espeak-ng (robotic). Set RESUME_VIDEO_VOICE=off to disable.
RESUME_VIDEO_VOICE=
# Piper overrides (normally auto-detected; nixpacks installs it on Railway):
PIPER_BIN=
PIPER_VOICE=
PIPER_VOICE_ID=en_US-lessac-medium
PIPER_DATA_DIR=
PIPER_AUTODOWNLOAD=
# Studio-quality voice for the downloadable MP4 (ElevenLabs). When set, paid
# subscribers' videos use it; free users fall back to Piper/espeak. Set
# ELEVENLABS_FREE_TIER=on to give it to everyone (spends credits per video).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_FREE_TIER=

# Personal websites — switch published sites onto <name>.resumetailored.com.
# Leave unset to keep /site/<name> URLs. Only set this once a wildcard DNS
# record AND a wildcard TLS certificate exist for *.resumetailored.com
# (see docs/RAILWAY_SETUP.md §9) — without both, every site link breaks.
# SITE_PUBLIC_HOST=resumetailored.com
