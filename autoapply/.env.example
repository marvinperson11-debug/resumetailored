# ── Database (PostgreSQL) ────────────────────────────────────────────────
# Local: docker run -e POSTGRES_PASSWORD=pw -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:pw@localhost:5432/autoapply?schema=public"

# ── NextAuth ─────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# ── Browser extension access ─────────────────────────────────────────────
# The extension IDs allowed to call the extension-facing API (CORS + origin
# allowlist). Comma-separated chrome-extension://<id> origins.
# During dev you can use the unpacked extension id printed at chrome://extensions
EXTENSION_ORIGINS="chrome-extension://__DEV_EXTENSION_ID__"

# ── Main ResumeTailored app bridge (apply-queue sync) ────────────────────
# The AutoApply app reads/writes the user's apply queue from the MAIN
# ResumeTailored app, which is the source of truth (/api/apply-queue). The two
# apps share no session store — they share the user's EMAIL — so this app
# authenticates to the main app as a trusted first-party service using a shared
# secret. Both values are read only on the server and never sent to the browser
# or the extension. Leave unset to disable the bridge (the app falls back to its
# own local job list).
#   RT_MAIN_APP_URL  — origin of the main app (e.g. https://resumetailored.com)
#   RT_SERVICE_TOKEN — MUST match the main app's RT_SERVICE_TOKEN env var
RT_MAIN_APP_URL="http://localhost:3000"
RT_SERVICE_TOKEN=""
